# Add to ~/.gitconfig (or run the `git config --global` commands in docs/tools.md).
# Makes `git diff`, `git log -p` and `git show` render through delta.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ansi
	side-by-side = false
[merge]
	conflictstyle = zdiff3
