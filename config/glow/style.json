{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#e6e6e6",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#7a7a7a"
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#e6e6e6",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#e6e6e6",
    "bold": true
  },
  "h2": {
    "prefix": "",
    "color": "#e6e6e6",
    "bold": true
  },
  "h3": {
    "prefix": "",
    "color": "#d4d4d4"
  },
  "h4": {
    "prefix": "",
    "color": "#a8a8a8"
  },
  "h5": {
    "prefix": "",
    "color": "#a8a8a8"
  },
  "h6": {
    "prefix": "",
    "color": "#7a7a7a",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#7a7a7a",
    "format": "\n────────\n"
  },
  "item": {
    "block_prefix": "• ",
    "color": "#7a7a7a"
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#7a7a7a"
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] ",
    "color": "#8fbf8f"
  },
  "link": {
    "color": "#8fb0d9",
    "underline": true
  },
  "link_text": {
    "color": "#e6e6e6",
    "bold": true
  },
  "image": {
    "color": "#8fb0d9",
    "underline": true
  },
  "image_text": {
    "color": "#7a7a7a",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#e6e6e6",
    "background_color": "#1e1e1e"
  },
  "code_block": {
    "color": "#7a7a7a",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#e6e6e6"
      },
      "error": {
        "color": "#d98c8c"
      },
      "comment": {
        "color": "#7a7a7a"
      },
      "comment_preproc": {
        "color": "#7a7a7a"
      },
      "keyword": {
        "color": "#8fb0d9"
      },
      "keyword_reserved": {
        "color": "#8fb0d9"
      },
      "keyword_namespace": {
        "color": "#8fb0d9"
      },
      "keyword_type": {
        "color": "#8fb0d9"
      },
      "operator": {
        "color": "#a8a8a8"
      },
      "punctuation": {
        "color": "#a8a8a8"
      },
      "name": {
        "color": "#e6e6e6"
      },
      "name_builtin": {
        "color": "#e6e6e6"
      },
      "name_tag": {
        "color": "#8fb0d9"
      },
      "name_attribute": {
        "color": "#e6e6e6"
      },
      "name_class": {
        "color": "#e6e6e6",
        "bold": true
      },
      "name_constant": {},
      "name_decorator": {
        "color": "#a8a8a8"
      },
      "name_exception": {},
      "name_function": {
        "color": "#e6e6e6"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {
        "color": "#d9c48c"
      },
      "literal_date": {},
      "literal_string": {
        "color": "#8fbf8f"
      },
      "literal_string_escape": {
        "color": "#d9c48c"
      },
      "generic_deleted": {
        "color": "#d98c8c"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#8fbf8f"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#7a7a7a"
      },
      "background": {
        "background_color": "#1e1e1e"
      }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}